# Required for local development and Vercel deployment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback if using an older Supabase anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do not set service-role keys for the MVP.
SUPABASE_SECRET_KEY=

# Server-only YouTube sync settings. Never expose these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_SYNC_TOKEN_SECRET=
